# Configuration for vps-incident-assistant.
# Copy to .env (gitignored). Secrets have no example value.

# Optional: overrides the image digest pinned in compose.yaml.
# ASSISTANT_IMAGE=ghcr.io/philippklinger/vps-incident-assistant@sha256:...

# Required: shared secret that Uptime Kuma sends with each webhook.
WEBHOOK_SECRET=
# Required: GitHub token with read access to the five read repos.
GITHUB_READ_TOKEN=
# Required: GitHub token with Issues write on the issue repo only.
GITHUB_ISSUE_TOKEN=
# Required: repository the incident issues are created in.
ISSUE_REPO=PhilippKlinger/vps-incident-assistant
# Required: Telegram bot token for notifications.
TELEGRAM_BOT_TOKEN=
# Required: Telegram chat that receives the notifications.
TELEGRAM_CHAT_ID=
# Required: AWS region of the Bedrock runtime endpoint.
BEDROCK_REGION=eu-north-1
# Required: Bedrock inference profile ID of the model (eu. prefix).
BEDROCK_MODEL=
# Required: long-term Bedrock API key, sent as bearer token.
AWS_BEARER_TOKEN_BEDROCK=
