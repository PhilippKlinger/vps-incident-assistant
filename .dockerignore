# Secrets and local configuration never go into the image
.env
.env.*
!.env.example

# Version control and CI
.git
.gitattributes
.gitignore
.github

# Local Python environments and caches (also inside assistant/)
.venv
**/__pycache__
**/*.py[cod]
.ruff_cache
.pytest_cache

# Tests and tooling are not needed at runtime
tests
requirements-dev.txt
pyproject.toml

# Container and documentation files themselves
Dockerfile
.dockerignore
compose.yaml
README.md

# Editor settings
.vscode
.idea
